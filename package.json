{
  "name": "app4cam-backend",
  "version": "5.7.0-next",
  "license": "GPL-3.0-or-later",
  "contributors": [
    {
      "name": "Adriano Gama",
      "email": "adriano.gama@list.lu"
    },
    {
      "name": "Daniel Waxweiler",
      "email": "daniel.waxweiler@list.lu"
    }
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build/save-commit-hash-to-file.cjs && nest build",
    "format": "prettier --write --ignore-unknown .",
    "prepare": "husky",
    "start": "node scripts/build/save-commit-hash-to-file.cjs && cross-env NODE_ENV=development nest start",
    "start:dev": "node scripts/build/save-commit-hash-to-file.cjs && cross-env NODE_ENV=development nest start --watch",
    "start:debug": "node scripts/build/save-commit-hash-to-file.cjs && cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "archiver": "7.0.1",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "luxon": "3.7.2",
    "path": "0.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/archiver": "7.0.0",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "cross-env": "10.1.0",
    "dotenv": "18.0.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "node-mocks-http": "1.18.1",
    "prettier": "3.9.9",
    "prettier-plugin-sh": "0.20.2",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint",
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "msw@2.15.0": true,
    "esbuild@0.28.2": true
  }
}
